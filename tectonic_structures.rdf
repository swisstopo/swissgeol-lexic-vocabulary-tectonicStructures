</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/GressoneyShearZone">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Val de Gressoney (Italia): coord. 2630000/1070000</rdfs:isDefinedBy>
	<skos:example xml:lang="en">Gressoney extensional shear zone = Gressoney Shear Zone (Babist et al. 2006)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
