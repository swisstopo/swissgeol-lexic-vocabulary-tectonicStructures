	<skos:prefLabel xml:lang="de">Amburnex-Überschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Chevauchement des Amburnex</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sovrascorrimento dei Amburnex</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Thrust"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/LaDoleThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The La Dôle Thrust is a thrust situated within the La Dôle Block.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
