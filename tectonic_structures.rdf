<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/GiudicarieSouthFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Giudicarie (South) Fault is a Miocene brittle fault, which crops out in the Giudicarie and Rendena valleys, north of Lago di Garda. This major fault is a NNE- SSW oriented segment of the Periadriatic Fault System. The Giudicarie (South) Fault is entirely located in the South Alpine.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Giudicarie South Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Giudicarie-Südstörung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille méridionale des Giudicarie</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia meridionale delle Giudicarie</skos:prefLabel>
