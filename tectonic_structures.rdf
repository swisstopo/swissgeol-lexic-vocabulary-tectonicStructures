	<skos:prefLabel xml:lang="fr">Faille de Divonne</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia di Divonne</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlipDextral"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

