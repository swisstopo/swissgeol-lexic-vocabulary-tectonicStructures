	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/SamoensMontBuetThrust"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ValtortaValcanaleThrust"/>
	<adms:status xml:lang="en">active</adms:status>
