	<skos:definition xml:lang="en">The Bolettone Thrust is a major tectonic structure of the Southern Prealps, traversing the Larian Triangle area between Lake Como and Lake Lecco.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Bolettone Thrust</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Bolettone-Überschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Chevauchement du Bolettone</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sovrascorrimento del Bolettone</skos:prefLabel>
	<skos:altLabel xml:lang="fr">Chevauchement du Monte Bolettone</skos:altLabel>
	<skos:altLabel xml:lang="it">Sovrascorrimento del Monte Bolettone</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Thrust"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/AelsnauFold">
