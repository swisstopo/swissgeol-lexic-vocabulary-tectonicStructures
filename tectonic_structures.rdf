<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/SchlinigThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Schlinig Thrust, located near the Switzerland-Austria-Italy triple point, is a major WNW-directed thrust within the Upper Austroalpine subdomain, which lead to the emplacement of the tectonically higher Ötztal Nappe Complex over the underlying S-charl-Sesvenna Nappe and the Campo Nappe Complex. It can be followed as an intra-basement shear zone all along the Etsch Valley (Vinschgau) eastwards for some 40 km.</skos:definition>
	<skos:scopeNote xml:lang="en">Austroalpine</skos:scopeNote>
	<skos:example xml:lang="de">Schlining-Überschiebung (Medwenitsch 1962), Schlinig-Linie (Schmid 1973), --- (Schmid &amp; Haas 1989), Schlinig-Überschiebung = Schlinig-Linie (Stutz &amp; Walter 1983)</skos:example>
	<skos:example xml:lang="en">Schlinig line = Schlinig thrust (Hoinkes &amp; Thöni 1993), Schlinig fault (Froitzheim et al. 1997), Schlinig Thrust (Gouffon et al. 2024)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Schlinig Thrust</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Schlinig-Überschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Chevauchement de Schlinig</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sovrascorrimento di Slingia</skos:prefLabel>
	<skos:altLabel xml:lang="en">Schlinig Fault</skos:altLabel>
	<skos:altLabel xml:lang="de">Schlinig-Störung</skos:altLabel>
	<skos:altLabel xml:lang="de">Schlinig-Linie</skos:altLabel>
	<skos:altLabel xml:lang="it">Sovrascorrimento dello Schlinig</skos:altLabel>
	<skos:altLabel xml:lang="fr">Chevauchement du Schlinigtal</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ThrustForward"/>
	<skos:broadMatch rdf:resource="https://voc.europe-geology.eu/hike/faults/480"/>
	<skos:broadMatch rdf:resource="https://resource.geosphere.at/thes/fault/175"/>
	<skos:closeMatch rdf:resource="https://resource.geosphere.at/thes/fault/631"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/GallineraThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Gallinera Thrust corresponds to the eastern part of the main thrust of the Upper Orobic Nappe. It marks a change in the regional strike of the thrust, from E–W to NE–SW, likely due to the presence of a sinistral transfer zone towards the Giudicarie Fault. Since the Gallinera Thrust is clearly cut off by the Adamello Batholith, this sinistral transfer zone could, at least in part, be pre-Adamello in age.</skos:definition>
	<skos:scopeNote xml:lang="en">Southalpine</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Gallinera Thrust</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Gallinera-Überschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Chevauchement de Gallinera</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sovrascorrimento di Gallinera</skos:prefLabel>
	<skos:altLabel xml:lang="de">Gallinera-Sellero-Überschiebung</skos:altLabel>
	<skos:altLabel xml:lang="en">Gallinera-Sellero Thrust</skos:altLabel>
	<skos:altLabel xml:lang="fr">Chevauchement de Gallinera-Sellero</skos:altLabel>
	<skos:altLabel xml:lang="it">Sovrascorrimento di Gallinera-Sellero</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ThrustForward"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/Decollement">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">large-scale basal thrust</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
