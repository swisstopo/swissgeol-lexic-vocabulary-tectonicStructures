	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ThrustForward"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/CombeDuVertThrust"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/LesBiouxThrust"/>
