<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/CombeDuVertThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Combe du Vert Thrust is a thrust situated within the Mont Risoux Block, at the northern border of the Vallée de Joux.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Combe du Vert Thrust</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Combe-du-Vert-Überschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Chevauchement de la Combe du Vert</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sovrascorrimento della Combe du Vert</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Thrust"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/LesBiouxThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Les Bioux Thrust is a small (3rd order) thrust situated within the Mont Tendre Block, south of the Vallée de Joux.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Les Bioux Thrust</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Les-Bioux-Überschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Chevauchement des Bioux</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sovrascorrimento dei Bioux</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Thrust"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/MarchairuzThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Marchairuz Thrust is a small (3rd order) thrust situated within the Mont Tendre Block.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
