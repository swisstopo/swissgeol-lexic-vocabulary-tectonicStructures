<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/MandachThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Mandach Thrust, running between Frick and Andelfingen, is the frontal N-vergent thrust delimiting the Bözberg Block. It is considered as the northern boundary of the Detached North Alpine Foreland.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Mandach Thrust</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Mandach-Überschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Chevauchement de Mandach</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sovrascorrimento di Mandach</skos:prefLabel>
	<skos:altLabel xml:lang="en">Mandach Overthrust, Bözberg Décollement</skos:altLabel>
	<skos:altLabel xml:lang="de">Mandacher Störung</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ThrustForward"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/MontTerriThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Mont Terri Thrust represents the Main Jura Thrust in the Haute Ajoie region (easternmost part of the Central Jura), where the Internal Folded Jura directly overlies the Haute-Saône Platform (Nussbaum et al. 2017).</skos:definition>
	<skos:scopeNote xml:lang="en">Jura</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Mont Terri Thrust</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Mont-Terri-Überschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Chevauchement du Mont Terri</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sovrascorrimento del Mont Terri</skos:prefLabel>
	<skos:altLabel xml:lang="en">Mont Terri Line</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ThrustForward"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/JuraMainThrust"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/PaudezeThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Paudèze Thrust is the frontal thrust of the Belmont Slice (over the Plateau Molasse), and hence of the Subalpine Molasse of Western Switzerland.</skos:definition>
	<skos:definition xml:lang="fr">Accident tectonique représentant le chevauchement frontal de la Molasse subalpine en Suisse romande.</skos:definition>
	<skos:scopeNote xml:lang="en">Subalpine Molasse</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Paudèze Thrust</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Paudèze-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Accident de la Paudèze</skos:prefLabel>
	<skos:altLabel xml:lang="fr">Faille de la Paudèze, Chevauchement de la Paudèze</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ThrustForward"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

