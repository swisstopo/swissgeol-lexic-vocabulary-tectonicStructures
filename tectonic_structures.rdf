	<skos:prefLabel xml:lang="de">Syam-Überschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Chevauchement de Syam</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sovrascorrimento di Syam</skos:prefLabel>
	<skos:altLabel xml:lang="en">Siam Fault</skos:altLabel>
	<skos:altLabel xml:lang="fr">Accident de Syam, Accident de Siam</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ThrustForward"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/MontTendreThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Mont Tendre Thrust is the frontal NW-vergent thrust bringing the Mont Tendre Block ontop of the Mont Risoux Block.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D (Jura vaudois)</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Mont Tendre Thrust</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Mont-Tendre-Überschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Chevauchement du Mont Tendre</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sovrascorrimento del Mont Tendre</skos:prefLabel>
	<skos:altLabel xml:lang="de">Risoux-Überschiebung</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ThrustForward"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/MontRisouxThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Mont Risoux Thrust is the frontal NW-vergent thrust delimiting the Mont Risoux Block. It is a 1st order thrust connected to the basal décollement of the Jura Fold-and-Thrust Belt.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D (Jura vaudois)</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Mont Risoux Thrust</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Mont-Risoux-Überschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Chevauchement du Mont Risoux</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sovrascorrimento del Mont Risoux</skos:prefLabel>
	<skos:altLabel xml:lang="de">Risoux-Überschiebung</skos:altLabel>
	<skos:altLabel xml:lang="en">Risoux Thrust</skos:altLabel>
	<skos:altLabel xml:lang="fr">Chevauchement du Risoux</skos:altLabel>
	<skos:altLabel xml:lang="it">Sovrascorrimento del Risoux</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ThrustForward"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

