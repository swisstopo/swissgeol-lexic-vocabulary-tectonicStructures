	<skos:definition xml:lang="en">The Ammerzwil Syncline is a fold of the Plateau Molasse in the region around Lyss.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
