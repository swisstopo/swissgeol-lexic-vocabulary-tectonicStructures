	<skos:prefLabel xml:lang="de">Epiquerez-Antiklinale</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Anticlinal d'Epiquerez</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Anticlinale di Epiquerez</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Anticline"/>
</rdf:Description>

