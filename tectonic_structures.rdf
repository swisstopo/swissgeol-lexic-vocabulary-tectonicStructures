	<rdfs:isDefinedBy>Älsnau (LU): coord. 2645150/1215555</rdfs:isDefinedBy>
	<skos:definition xml:lang="en">The Älsnau Syncline ia a large-amplitude fold of the Plateau Molasse developped between the Napf region and the Sempach Lake.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Älsnau Syncline</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Älsnau-Synklinale</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Synclinal d'Älsnau</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sinclinale di Älsnau</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Syncline"/>
