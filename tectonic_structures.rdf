<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/CruseillesFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The NNW-SSE trending Cruseilles Fault is a sinistral strike-slip fault at the southern end of the main Salève ridge, running along the Usses valley where it is crossed by the Pont de la Caille.</skos:definition>
	<skos:scopeNote xml:lang="en">Salève</skos:scopeNote>
	<skos:example xml:lang="en">décrochement de Cruseilles (Charollais et al. 1988)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Cruseilles Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Cruseilles-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille de Cruseilles</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia di Cruseilles</skos:prefLabel>
	<skos:altLabel xml:lang="fr">Décrochement de Cruseilles, Zone de failles de Cruseilles, Système de Cruseilles</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlipSinistral"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/CoinFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Le Coin Fault is a sinistral strike-slip fault cutting across the Salève.</skos:definition>
	<skos:definition xml:lang="fr">Décrochement senestre recoupant le chaînon du Salève.</skos:definition>
	<skos:scopeNote xml:lang="en">Salève</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Le Coin Fault Corridor</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Le-Coin-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille du Coin</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia del Coin</skos:prefLabel>
	<skos:altLabel xml:lang="fr">Corridor de faille du Coin, Zone de failles du Coin</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlipSinistral"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/DazenetFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The relatively short NNE-SSW trending Dazenet Fault is a sinistral strike-slip fault between the Mont Châteleu Block and the Doubs Block, connecting the Morteau Thrust and the Côtes du Doubs Thrust.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Dazenet Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Dazenet-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille du Dazenet</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia del Dazenet</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlipSinistral"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/RochefortFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The N-S trending Rochefort Fault is a sinistral strike-slip fault between the Chasseral Block and the Vallée des Ponts Block, connecting the Travers Thrust and the Marmoud Thrust.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">RochefortFault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Rochefort-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille de Rochefort</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia di Rochefort</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlipSinistral"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/FerriereFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The NNE-SSW trending Ferrière Fault Zone is a major (1st order) sinistral strike-slip fault of the Central Jura.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">La Ferrière Fault Zone</skos:prefLabel>
	<skos:prefLabel xml:lang="de">La-Ferrière-Störungszone</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Zone de faillea de la Ferrière</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Zona di faglie della Ferrière</skos:prefLabel>
	<skos:altLabel xml:lang="fr">Accident of La Ferrière</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlipSinistral"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/VuacheFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:isDefinedBy>Montagne du Vuache (Haute-Savoie, France): coord. 2483600/1101900</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The NNW-SSE trending Vuache Fault is a large sinistral strike-slip fault running from Fort-de-l'Ecluse (or even possibly Lons-le-Saunier) to Annecy, along the southwestern flank of the Vuache mountain ridge. It separates the Southwestern Jura from the Central Jura.</skos:definition>
	<skos:scopeNote xml:lang="en">Genève</skos:scopeNote>
	<skos:example xml:lang="fr">Faille du Vuache (Blondel 1984, Blondel 2026)</skos:example>
	<skos:example xml:lang="en">faille du Vuache (De la Harpe 1996, Donzeau et al. 1997)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Vuache Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Vuache-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille du Vuache</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia del Vuache</skos:prefLabel>
	<skos:altLabel xml:lang="fr">Accident du Vuache</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlipSinistral"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/AubonnePontarlierFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Aubonne-Pontarlier Fault Zone is a major (1st order) N-S trending sinistral strike-slip fault cutting transversally the whole Jura Fold-and-Thrust Belt. It displaces the Main Jura Thrust front towards the south, similarly to the Mouthe Fault Zone further to the west.</skos:definition>
	<skos:definition xml:lang="fr">La zone de failles d’Aubonne–Pontarlier est l’un des décrochements les plus proéminents ; elle se compose d’un ensemble de failles à géométrie transpressive et peut être divisée en deux tronçons : au nord la faille de Pontarlier et au sud de Vallorbe la faille d’Aubonne. Le segment méridional de la zone de failles d’Aubonne–Pontarlier est décalé vers l’ouest par rapport au segment septentrional, et la liaison entre les deux segments est assurée par le chevauchement de la Dent de Vaulion (au sud-ouest de Vallorbe), orienté vers le nord (Mosar &amp; Jordan 2022).</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D (Jura vaudois)</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Aubonne-Pontarlier Fault Zone</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Aubonne-Pontarlier-Störungszone</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Zone de failles d'Aubonne-Pontarlier</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Zona di faglie di Aubonne-Pontarlier</skos:prefLabel>
	<skos:altLabel xml:lang="de">Aubonne-Pontarlier-Linie</skos:altLabel>
	<skos:altLabel xml:lang="fr">Décrochement d'Aubonne-Pontarlier</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlipSinistral"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/AubonneFault"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/PontarlierFault"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/MoutheFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Mouthe Fault Zone is a major NNE-SSW trending sinistral strike-slip fault zone that displaces the Main Jura Thrust front towards the south, similar to the Aubonne-Pontarlier Fault Zone further east.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Mouthe Fault Zone</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Mouthe-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Zone de failles de Mouthe</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Zona di faglie di Mouthe</skos:prefLabel>
	<skos:altLabel xml:lang="fr">Accident tectonique de Mouthe</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlipSinistral"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/StClaudeFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The St. Claude Fault is a sinistral strike-slip fault of the meridional Jura.</skos:definition>
	<skos:scopeNote xml:lang="en">Jura</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">St. Claude Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">St.-Claude-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille de St-Claude</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia di St-Claude</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlipSinistral"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/FribourgFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:isDefinedBy>Fribourg = Freiburg (FR): coord. 2579420/1183725</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Fribourg Lineament is a sinistral fault zone, which is seismically still active and may be related to the change of the main shear horizon from the Keuper Group evaporites (west) to the Muschelkalk Group evaporites (east).</skos:definition>
	<skos:scopeNote xml:lang="en">Foreland Plateau</skos:scopeNote>
	<skos:example xml:lang="en">Fribourg Lineament (Vouillamoz et al. 2016, Vouillamoz et al. 2017, Gouffon et al. 2024)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Fribourg Lineament</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Freiburg-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille de Fribourg</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia di Fribourg</skos:prefLabel>
	<skos:altLabel xml:lang="en">Fribourg Line</skos:altLabel>
	<skos:altLabel xml:lang="fr">Accident tectonique de Fribourg</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlipSinistral"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/DivonneFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Divonne Fault is a WNW-ESE trending dextral strike-slip fault within the Molasse Basin Block.</skos:definition>
	<skos:scopeNote xml:lang="en">Jura</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
