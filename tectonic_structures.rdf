	<skos:prefLabel xml:lang="de">Avants-Monts-Überschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Chevauchement des Avants-Monts</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sovrascorrimento degli Avants-Monts</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ThrustForward"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/EchallensAnticline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy xml:lang="en">Gouffon Y. (2024): Tectonic Map of Switzerland 1:50'0000. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:isDefinedBy>SE of Echallens at Poliez-le-Grand (VD): coord. 2540105/1165215</rdfs:isDefinedBy>
	<skos:definition xml:lang="en">The Echallens Anticline is a fold of the Plateau Molasse situated 14 km to the north of Lausanne.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Echallens Anticline</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Anticlinal d'Echallens</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Echallens-Antiklinale</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Anticlinale di Echallens</skos:prefLabel>
	<skos:hiddenLabel xml:lang="fr">Anticlinal d'Echalens [sic]</skos:hiddenLabel>
	<skos:changeNote xml:lang="en">MORA 2026: correct spelling is Echallens (2 l's)</skos:changeNote>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Anticline"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/EntreDeuxMontsAnticline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy xml:lang="en">Gouffon Y. (2024): Tectonic Map of Switzerland 1:50'0000. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:isDefinedBy>Entre deux Monts (NE): coord. 2550500/1211280</rdfs:isDefinedBy>
	<skos:definition xml:lang="en">The Entre deux Monts Anticline is a fold of the Vallée des Ponts Unit (Jura Mountains), situated 2,5 km south of Le Locle.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Entre deux Monts Anticline</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Entre-deux-Monts-Antiklinale</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Anticlinal d'Entre deux Monts</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Anticlinale di Entre deux Monts</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Anticline"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/EpiquerezAnticline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy xml:lang="en">Gouffon Y. (2024): Tectonic Map of Switzerland 1:50'0000. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:isDefinedBy>Epiquerez (JU): coord. 2570550/1241800</rdfs:isDefinedBy>
	<skos:definition xml:lang="en">The Epiquerez Anticline is a fold of the Clos du Doubs Block (Jura Mountains), which the Doubs river flows round in the region of St-Ursanne.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
