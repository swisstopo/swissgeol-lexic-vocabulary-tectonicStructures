	<skos:prefLabel xml:lang="de">Marchairuz-Überschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Chevauchement du Marchairuz</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sovrascorrimento del Marchairuz</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Thrust"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/NeuveThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The La Neuve Thrust is a small (3rd order) thrust situated within the Mont Tendre Block.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
