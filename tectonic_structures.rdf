	<skos:prefLabel xml:lang="it">Anticlinale delle Boveresses</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Anticline"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/LesCheseauxAnticline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy xml:lang="en">Gouffon Y. (2024): Tectonic Map of Switzerland 1:50'0000. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:isDefinedBy>St-Cergue at Les Cheseaux-Dessus (VD): coord. 2501000/1144790</rdfs:isDefinedBy>
	<skos:definition xml:lang="en">The Les Cheseaux Anticline is a fold of the Mont Tendre Block (Jura Mountains), extending between St-Cergue and the southern side of the Col du Marchairuz.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="de">Les-Cheseaux-Antiklinale</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Les Cheseaux Anticline</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Anticlinal des Cheseaux</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Anticlinale dei Cheseaux</skos:prefLabel>
	<skos:hiddenLabel xml:lang="fr">Anticlinal des Chesaux [sic]</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="de">Cheseaux-Antiklinale</skos:hiddenLabel>
	<skos:changeNote xml:lang="en">The correct name of the locality is neither Chesaux nor Cheseaux(-sur-Lausanne), but Les Cheseaux-Dessus (St-Cergue).</skos:changeNote>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Anticline"/>
</rdf:Description>

