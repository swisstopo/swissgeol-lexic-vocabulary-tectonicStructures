<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/RhoneFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Rhône Fault, still seismically active, is a dextral strike-slip fault running along the Rhône valley between Brig and Martigny.</skos:definition>
	<skos:definition xml:lang="fr">Essaim de décrochements dextres subverticaux suivant la vallée du Rhône entre Viège et Martigny.</skos:definition>
	<skos:scopeNote xml:lang="en">Valais</skos:scopeNote>
	<skos:example xml:lang="fr">ligne du Rhône (Gouffon 1993)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Rhône Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Rhone-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille du Rhône</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia del Rhône</skos:prefLabel>
	<skos:altLabel xml:lang="fr">Accident du Rhône</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlipDextral"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/RhoneSimplonFault"/>
	<adms:status xml:lang="en">active</adms:status>
	<dct:source>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</dct:source>
	<dct:bibliographicCitation>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</dct:bibliographicCitation>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/YverdonFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The NW–SE trending Yverdon Fault is a dextral strike-slip fault of the Foreland Plateau.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D (Jura vaudois)</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Yverdon Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Yverdon-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille d'Yverdon</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia di Yverdon</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlipDextral"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/LanceFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The NW–SE trending La Lance Fault Zone is a large (2nd order) dextral strike-slip fault of the Foreland Plateau, cutting across Lac de Neuchâtel into the Jura Mountains.</skos:definition>
	<skos:scopeNote xml:lang="en">Foreland Plateau, swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">La Lance Fault Zone</skos:prefLabel>
	<skos:prefLabel xml:lang="de">La-Lance-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille de la Lance</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia della Lance</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlipDextral"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/SarrazMormontFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The NW–SE trending La Sarraz–Mormont Fault Zone is a large (2nd order) dextral strike-slip fault of the Foreland Plateau.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D (Jura vaudois)</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">La Sarraz-Mormont Fault Zone</skos:prefLabel>
	<skos:prefLabel xml:lang="de">La-Sarraz-Mormont-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Zone de failles de La Sarraz-Mormont</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Zona di faglie della Sarraz-Mormont</skos:prefLabel>
	<skos:altLabel xml:lang="en">La Sarraz Fault Zone</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlipDextral"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/StCergueFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The NW–SE trending St-Cergue Fault Zone is a major (1st order) dextral strike-slip fault cutting transversally the whole Jura Fold-and-Thrust Belt.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D (Jura vaudois)</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">St-Cergue Fault Zone</skos:prefLabel>
	<skos:prefLabel xml:lang="de">St-Cergue-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Zone de failles de St-Cergue</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia di St-Cergue</skos:prefLabel>
	<skos:hiddenLabel xml:lang="en">St-Cergues Fault Zone</skos:hiddenLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlipDextral"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/BonmontYvoireFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The WNW–ESE trending Bonmont-Yvoire Fault Zone is a large (2nd order) dextral strike-slip fault within the Molasse Basin Block.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Bonmont-Yvoire Fault Zone</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Bonmont-Yvoire-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille de Bonmont-Yvoire</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia di Bonmont-Yvoire</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlipDextral"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/SeptmoncelFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The NW–SE trending Septmoncel Fault is a dextral strike-slip fault of the meridional Jura.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Septmoncel Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Septmoncel-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille de Septmoncel</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia di Septmoncel</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlipDextral"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/CentovalliFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Centovalli (TI), coord. 2693500/1113250</rdfs:isDefinedBy>
	<skos:definition xml:lang="en">The E-W striking Centovalli Fault is a dextral strike-slip fault extending between Locarno and Domodossoéa. It formed under epi- to anchizonal conditions during the Miocene.</skos:definition>
	<skos:example xml:lang="en">Centovalli Fault (Gouffon et al. 2024)</skos:example>
	<skos:example xml:lang="de">Centovallistörung (Bearth 1956)</skos:example>
	<skos:example xml:lang="fr">ligne des Centovalli (Gouffon 1993)</skos:example>
	<skos:example xml:lang="en">Centovalli strike-slip fault (Steck 2008)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Centovalli Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Centovalli-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille des Centovalli</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia delle Centovalli</skos:prefLabel>
	<skos:altLabel xml:lang="en">Centovalli Line</skos:altLabel>
	<skos:notation>CL</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlipDextral"/>
	<skos:related rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/RhoneSimplonFault"/>
	<adms:status xml:lang="en">active</adms:status>
	<dct:source>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</dct:source>
	<dct:bibliographicCitation>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</dct:bibliographicCitation>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/PoyetteFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The NE-SW trending La Poyette Fault is a dextral strike-slip fault between the Le Suchet Block and the Romainmôtier Block, connecting the Les Cernis Thrust and the Baulmes Thrust.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">La Poyette Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">La-Poyette-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille de la Poyette</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia della Poyette</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlipDextral"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/BellefontaineFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The NE-SW trending Bellefontaine Fault is a strike-slip fault of the Central Jura, separating the Roche d'Or Block from the Clos du Doubs Block.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Bellefontaine Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Bellefontaine-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille de Bellefontaine</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia di Bellefontaine</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlip"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/CaquerelleFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The NE-SW trending La Caquerelle Fault Zone is a major (1st order) sinistral strike-slip fault separating the Central Jura from the Rhenish (and hence Eastern) Jura.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">La Caquerelle Fault Zone</skos:prefLabel>
	<skos:prefLabel xml:lang="de">La-Caquerelle-Störungszone</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Zone de failles de la Caquerelle</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Zona di faglie della Caquerelle</skos:prefLabel>
	<skos:altLabel xml:lang="de">Caquerelle Linie</skos:altLabel>
	<skos:altLabel xml:lang="fr">décrochement de la Caquerelle, accident de la Caquerelle</skos:altLabel>
	<skos:altLabel xml:lang="de">Caquerelle-Zone</skos:altLabel>
	<skos:notation xml:lang="en">CQ</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlip"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/MorezFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The NNW-SSE trending Morez Fault connects the St-Cergue Fault to the Syam Thrust.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Morez Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Morez-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille de Morez</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia di Morez</skos:prefLabel>
	<skos:altLabel xml:lang="fr">Accident de Morez</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlip"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/LuganoFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The N–S trending Lugano Fault represents the southern segment of the Lugano-Monte Grona-Val Grande Fault System. It extends at least from Mendrisio northwards to northeast of Lugano.</skos:definition>
	<skos:scopeNote xml:lang="en">Southalpine</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Lugano Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Lugano-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille de Lugano</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia di Lugano</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/LuganoMonteGronaValGrandeFault"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/MonteGronaFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The W–E oriented Monte Grona Fault represents the median segment of the Lugano-Monte Grona-Val Grande Fault System. It extends from northeast of Lugano to Lago di Como and was reactivated as an alpine backthrust (N-directed),</skos:definition>
	<skos:scopeNote xml:lang="en">Southalpine</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Monte Grona Backthrust</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Rétrochevauchement du Monte Grona</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Monte-Grona-Rücküberschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Retrosovrascorrimento del Monte Grona</skos:prefLabel>
	<skos:altLabel xml:lang="en">Monte Grona Fault</skos:altLabel>
	<skos:altLabel xml:lang="de">Monte-Grona-Störung</skos:altLabel>
	<skos:altLabel xml:lang="fr">Faille du Monte Grona</skos:altLabel>
	<skos:altLabel xml:lang="it">Faglia del Monte Grona</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/LuganoMonteGronaValGrandeFault"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ThrustBackward"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/ValGrandeFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The SW–NE oriented Val Grande Fault represents the northeastern segment of the Lugano-Monte Grona-Val Grande Fault System. It extends from Lago di Como eastwards at least up to M. Legnone.</skos:definition>
	<skos:scopeNote xml:lang="en">Southalpine</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Val Grande Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Val-Grande-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille du Val Grande</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia della Val Grande</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/LuganoMonteGronaValGrandeFault"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/MezzaunFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Mezzaun Detachment Fault designates the southwestern rim of the underlying dome-shaped Murtiröl Slice. It is one of the most spectacular normal faults of the Austroalpine, attributed to the Late Cretaceous phase of extension that postdates Cretaceous shortening but predates Cenozoic collision.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Mezzaun Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Mezzaun-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Détachement de Mezzaun</skos:prefLabel>
	<skos:altLabel xml:lang="en">Mezzaun Detachment Fault, Mezzaun Normal Fault</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Detachment"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/PogalloFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Pogallo Fault, active as a low-angle detachment during Mesozoic rifting, separated the lower crustal Ivrea rocks from the middle–upper crustal Strona-Ceneri basement.</skos:definition>
	<skos:scopeNote xml:lang="en">Southalpine</skos:scopeNote>
	<skos:example xml:lang="it">Pogallo-Lago d'Orta (Boriani et al. 1990)</skos:example>
	<skos:example xml:lang="it">linea del Pogallo (Dal Piaz et al. 1992a)</skos:example>
	<skos:example xml:lang="en">Pogallo Fault (Gouffon et al. 2024)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Pogallo Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Pogallo-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille du Pogallo</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia del Pogallo</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Detachment"/>
	<adms:status xml:lang="en">active</adms:status>
	<dct:source>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</dct:source>
	<dct:bibliographicCitation>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</dct:bibliographicCitation>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/RhoneSimplonFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The two adjoining Rhône and Simplon faults are commonly referred together as the Rhône-Simplon Fault. Steck (1984, 2008) pointed out that a much broader dextral shear zone (his Simplon Ductile Shear Zone) preceded activity along the Rhône-Simplon Fault between 32 and 18 Ma, transforming much of the substantial dextral shearing along the Tonale Fault into thrusting in the frontal part of the Western Alps (e.g., Gouffon &amp; Burri 1997, Fig.7).</skos:definition>
	<skos:definition xml:lang="de">Bedeutende, südwestfallende, miozäne Abschiebung mit Mylonitzone im Liegenden (NE) und Kataklasitzone im Hangenden (SW).</skos:definition>
	<skos:scopeNote xml:lang="en">Valais</skos:scopeNote>
	<skos:example xml:lang="en">Rhône-Simplon Fault (Gouffon et al. 2024)</skos:example>
	<skos:example xml:lang="en">Simplon Fault Zone (Grasemann &amp; Mancktelow 1993)</skos:example>
	<skos:example xml:lang="en">Simplon ductile shear zone = Rhone-Simplon line (Steck 2008)</skos:example>
	<skos:example xml:lang="fr">ligne Rhône-Simplon (Gouffon 1993)</skos:example>
	<skos:example xml:lang="de">Simplon-Centovalli (Bearth 1954, 1956 und 1974)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Rhône-Simplon Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Rhone-Simplon-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille du Rhône-Simplon</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia del Rhône-Simplon</skos:prefLabel>
	<skos:altLabel xml:lang="de">Rhone-Simplon-Linie</skos:altLabel>
	<skos:hiddenLabel xml:lang="it">faglia del Rodano–Sempione</skos:hiddenLabel>
	<skos:notation>RSL</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultComposite"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/SimplonFault"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/RhoneFault"/>
	<adms:status xml:lang="en">active</adms:status>
	<dct:source>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</dct:source>
	<dct:bibliographicCitation>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</dct:bibliographicCitation>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/EngadineFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Engiadina Ota (GR), coord. 2795400/1165575</rdfs:isDefinedBy>
	<skos:definition xml:lang="en">The brittle SW–NE striking Engadine Fault accommodated sinistral strike-slip motion, combined with a rotation of the NW block with respect to the SE block. This relative block rotation resulted in a relative uplift of the SE block hosting the Bregaglia Intrusion at Passo del Maloja and in Val Bregaglia, while an opposite vertical throw is observed in the area of the western Lower Engadine Window where the SE block (the S-charl-Sesvenna Nappe) is downthrown and forms the hangingwall of a sinistrally transtensive normal fault (Schmid &amp; Froitzheim 1993, Trümpy et al. 1997). The correlation of the nappe units to both sides of the Engadine Fault yields some 2.8 km vertical and horizontal components of displacement near Maloja, 3.1 km pure horizontal strike-slip movement near Samedan and 3.2 km vertical and horizontal components at S-chanf. The vertical throw across the transtensive normal fault at the southeastern margin of the western Lower Engadine Window amounts to some 4 km. The southwestern end of the Engadine Fault in the lower Val Bregaglia very probably coincides with the northern margin of the Gruf Complex while its northeastern end near Nauders is hidden below a late-stage N-directed thrust of the Ötztal Nappe onto the Penninic units of the Lower Engadine Window. Faulting along the Engadine Fault certainly postdates the intrusion of the Val Bregaglia pluton and took place somewhere around the Oligocene-Miocene boundary, when the metamorphosed rocks in Val Bregaglia cooled down below the viscous–brittle transition.</skos:definition>
	<skos:definition xml:lang="fr">Faille complexe, principalement décrochante sénestre, d'âge Tertiaire terminal. Elle limite la fenêtre de la Basse Engadine dans sa partie sud-est.</skos:definition>
	<skos:scopeNote xml:lang="en">Extending from Chiavenna to Innsbruck (Trümpy 1977), along the Val Bregaglia, the Upper Engadine (Malojapass, St. Moritz, Zernez, Stragliavitapass), the Lower Engadine (Ardez, Prutz, Imst) and the Inn valley.</skos:scopeNote>
	<skos:example xml:lang="en">Engadine Fault (Gouffon et al. 2024)</skos:example>
	<skos:example xml:lang="de">Engadiner Störung = Stragliavita-Linie (Trümpy 1972)</skos:example>
	<skos:example xml:lang="de">Engadiner Linie (Medwenitsch 1962, Mützenberg 1986, Spillmann 1993)</skos:example>
	<skos:example xml:lang="it">Linea dell'Engadina (Wenk 1992)</skos:example>
	<skos:example xml:lang="fr">faille de l'Engadine (Bousquet 1998)</skos:example>
	<skos:example xml:lang="en">Engadine Line (Trümpy 1977)</skos:example>
	<skos:example xml:lang="de">Engadiner Lineament (Gruber et al. 2010)</skos:example>
	<skos:example xml:lang="de">Engadiner Störung (Furrer et al. 2015)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Engadine Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Engadin-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille de l'Engadine</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia dell'Engadina</skos:prefLabel>
	<skos:altLabel xml:lang="en">Engadine Line</skos:altLabel>
	<skos:notation>EL</skos:notation>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultComposite"/>
	<skos:broadMatch rdf:resource="https://resource.geosphere.at/thes/fault/171"/>
	<skos:broadMatch rdf:resource="https://voc.europe-geology.eu/hike/faults/478"/>
	<adms:status xml:lang="en">active</adms:status>
	<dct:source>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</dct:source>
	<dct:bibliographicCitation>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</dct:bibliographicCitation>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/AubonneFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Aubonne Fault represents the southern, NNW-SSE trending segment of the Aubonne-Pontarlier Fault Zone, situated between the Leman region and the Jura foot. It is connected towards the north with the Pontarlier Fault via the Dent de Vaulion Thrust.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D (Jura vaudois)</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Aubonne Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Aubonne-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille d'Aubonne</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia di Aubonne</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/AubonnePontarlierFault"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/PontarlierFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Pontarlier Fault represents the northern, N-S trending segment of the Aubonne-Pontarlier Fault Zone, situated north of the Main Jura Thrust. It is connected towards the south with the Aubonne Fault via the Dent de Vaulion Thrust.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D (Jura franc-comtois)</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Pontarlier Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Pontarlier-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille de Pontarlier</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia di Pontarlier</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/AubonnePontarlierFault"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/Thrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A thrust is a low-angle reverse fault accomodating a large displacement.</skos:definition>
	<skos:definition xml:lang="fr">Un chevauchement est une faille inverse à faible angle et déplacement relativement important.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
