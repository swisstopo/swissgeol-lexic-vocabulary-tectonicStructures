<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/PierreLenteFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Pierre Lente Fault is a NW-SE trending dextral strike-slip fault within the La Dôle Block running approximately 1 km south of and parallel to the St-Cergue Fault Zone.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
