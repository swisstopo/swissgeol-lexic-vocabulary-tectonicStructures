	<skos:prefLabel xml:lang="de">La-Dôle-Überschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Chevauchement de la Dôle</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sovrascorrimento della Dôle</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Thrust"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/LaRippeThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The La Rippe Thrust is a thrust situated to the south-east of the Jura foot on the southern side of the Bonmont-Yvoire Fault.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
