</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/ValsScaradraShearZone">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">Shear zone with steeply dipping foliation and shallowly-plunging, WSW-ENE oriented, i.e. orogen-parallel stretching lineation overprinting the northernmost part of the Adula Nappe and the adjacent Mesozoic metasediments.</skos:definition>
	<skos:example xml:lang="en">Vals-Scaradra Shear Zone = VSSZ (Kossak-Glowczewski et al. 2017)</skos:example>
	<skos:example xml:lang="fr">Mélange du Val Scaradra (Galster 2010)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Vals-Scaradra Shear Zone</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Vals-Scaradra-Scherzone</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Zone de cisaillement de Vals-Scaradra</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Zona di taglio di Vals-Scaradra</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ZoneShear"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/MontCarreShearZone">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Mont Carré (VS): coord. 2594130/1112160</rdfs:isDefinedBy>
	<skos:definition xml:lang="fr">Zone de cisaillement post-nappe à caractère rétrograde recoupant et décalant la zone de cisaillement post-nappe de l'Ar du Tsan et le synclinal des Dents Rousses entre le val de Nendaz et le val d'Hérémence. Elle est elle-même localement redressée par le pli rétrodéversé de Termeno Ro.</skos:definition>
	<skos:example xml:lang="fr">zone de cisaillement post-nappe du Mont Carré (Sartori &amp; Epard 2011)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Mont Carré Shear Zone</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Mont-Carré-Scherzone</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Zone de cisaillement du Mont Carré</skos:prefLabel>
