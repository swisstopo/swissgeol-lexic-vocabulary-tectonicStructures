	<skos:prefLabel xml:lang="de">Mijoux-Überschiebung</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ThrustForward"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/PremanonThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Prémanon Thrust is the frontal NW-vergent thrust delimiting the Prémanon Block.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Prémanon Thrust</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Prémanon-Überschiebung</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ThrustForward"/>
