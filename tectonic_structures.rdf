	<skos:prefLabel xml:lang="fr">Chevauchement de la Neuve</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sovrascorrimento della Neuve</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Thrust"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/AmburnexThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Amburnex Thrust is a thrust situated at the SW-border of the Mont Tendre Block at the contact to the St-Cergue Fault Zone.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
