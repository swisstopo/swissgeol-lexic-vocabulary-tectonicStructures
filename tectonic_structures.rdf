</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/BoveressesAnticline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy xml:lang="en">Gouffon Y. (2024): Tectonic Map of Switzerland 1:50'0000. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:isDefinedBy>Les Boveresses (BE): coord. 2578380/1225215</rdfs:isDefinedBy>
	<skos:definition xml:lang="en">The Boveresses Anticline is the frontal fold of the Chasseral Block (Jura Mountains) south of Corgémont.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Boveresses Anticline</skos:prefLabel>
