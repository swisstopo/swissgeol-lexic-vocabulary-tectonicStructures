	<rdfs:isDefinedBy>Belpberg (BE): coord. 2606175/1190365</rdfs:isDefinedBy>
	<skos:definition xml:lang="en">The Albligen-Belpberg Syncline is a fold of the Plateau Molasse, situated about 10 km south of Bern and extending between the Taverna valley to the W and Langnau-im-EMmental to the E.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
