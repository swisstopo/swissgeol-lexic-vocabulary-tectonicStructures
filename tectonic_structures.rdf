	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/MonteOlimpinoThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Monte Olimpino Backthrust, developped during the latest phases of deformation of the Lower Orobic Imbricates, brought the Lombardian Gompholite (synorogenic sediments ot the Milan Belt) onto the Lower Orobic Imbricates in the area south of Como–Chiasso–Varese.</skos:definition>
	<skos:scopeNote xml:lang="en">Southalpine</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Monte Olimpino Backthrust</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Monte-Olimpino-Rücküberschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Rétrochevauchement du Monte Olimpino</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Retrosovrascorrimento del Monte Olimpino</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ThrustBackward"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/MontTendreBackthrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Mont Tendre Backthrust is a SE-vergent thrust bringing the Mont Tendre Block back onto the Molasse Basin Block.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Mont Tendre Backthrust</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Mont-Tendre-Rücküberschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Rétrochevauchement du Mont Tendre</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Retrosovrascorrimento del Mont Tendre</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ThrustBackward"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

