</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/MundinShearZone">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="de">Scherzone zwische Mundin- und Arina-Einheiten.</skos:definition>
	<skos:scopeNote xml:lang="en">Unterengadiner Fenster</skos:scopeNote>
	<skos:example xml:lang="fr">Zone de Cisaillement du Mundin (Bousquet 1998)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
