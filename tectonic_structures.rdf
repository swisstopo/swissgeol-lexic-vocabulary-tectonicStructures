<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/BienneThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The La Bienne Thrust is the frontal NW-vergent thrust delimiting the La Bienne Block.</skos:definition>
