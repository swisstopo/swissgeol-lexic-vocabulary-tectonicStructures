<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/SyamThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Syam Thrust is a fault affecting the Champagnole Plateau. It is situated in the prolongation of the Mouthe Fault.</skos:definition>
	<skos:scopeNote xml:lang="en">Jura franc-comtois</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
