<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/Syncline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">In a syncline, the youngest strata are found in the core of the fold.</skos:definition>
	<skos:definition xml:lang="fr">Un pli synclinal présente les couches les plus récentes en son centre.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">syncline</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Synklinale</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">synclinal</skos:prefLabel>
	<skos:prefLabel xml:lang="it">sinclinale</skos:prefLabel>
	<skos:altLabel xml:lang="en">synclinal fold</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Synform"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/MontVullySyncline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ChamonixSyncline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/MolareSyncline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/StNiklausSyncline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/MontsetSyncline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/LandwasserSyncline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/DucanSyncline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/BernexSyncline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/CERNSyncline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ChallongesSyncline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ChoisySyncline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/CortengesSyncline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FrangySyncline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/GroisySyncline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/MarliozSyncline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/MeythetSyncline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/SaintGenisSyncline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ThonexSyncline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/VillazSyncline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/AelsnauFold"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/AlbligenBelpbergSyncline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/AltishofenSyncline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/AmmerzwilSyncline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FeselalpSyncline"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/RaronSyncline"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

