	<skos:prefLabel xml:lang="de">Sprüssel-Antiklinale</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Anticlinal de Sprüssel</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Anticlinale di Sprüssel</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Anticline"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/SiglistorfAnticline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Siglistorf Anticline is a compressional structure associated with a broad monocline of the Mesozoic sequence. It represents the northern boundary of the External Folded Jura against the autochthonous South German Platform.</skos:definition>
	<skos:example xml:lang="en">Siglistorf Anticline (Gouffon et al. 2024)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Siglistorf Anticline</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Siglistorf-Antiklinale</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Anticlinal de Siglistorf</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Anticlinale di Siglistorf</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Anticline"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

