<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/LomontAnticline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="fr">Il s'agit d'un pli anticlinal faillé qui sépare le plateau d'Ornans au Sud des zones préjurassiennes au Nord (Chauve et al. 1985).</skos:definition>
	<skos:scopeNote xml:lang="en">Jura (Ajoie)</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Lomont Anticline</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Lomont-Antiklinale</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Anticlinal du Lomont</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Anticlinale del Lomont</skos:prefLabel>
	<skos:altLabel xml:lang="fr">chaînon anticlinal du Lomont (Chauve et al. 1985)</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Anticline"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/ClervalAnticline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy xml:lang="en">Gouffon Y. (2024): Tectonic Map of Switzerland 1:50'0000. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:isDefinedBy>Clerval (France 25-Doubs): coord. 2528770/1249415</rdfs:isDefinedBy>
	<skos:definition xml:lang="en">The Clerval Anticline is a fold situated at the northern front of the Montagnes du Lomont, which represent the easternmost tip of the Besançon Faisceau.</skos:definition>
	<skos:scopeNote xml:lang="en">Jura (Ajoie)</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="fr">Anticlinal de Clerval</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Anticlinale di Clerval</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Clerval-Antiklinale</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Clerval Anticline</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Anticline"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

