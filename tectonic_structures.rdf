</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/BelCosterAnticline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy xml:lang="en">Gouffon Y. (2024): Tectonic Map of Switzerland 1:50'0000. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:isDefinedBy>Grand et Petit Bel Coster (VD): coord. 2523500/1178450</rdfs:isDefinedBy>
	<skos:definition xml:lang="en">The Bel Coster Anticline is a fold of the Jura Mountains, situated at the front of the Romainmôtier Block.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Bel Coster Anticline</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Bel-Coster-Antiklinale</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Anticlinal du Bel Coster</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Anticlinale del Bel Coster</skos:prefLabel>
	<skos:hiddenLabel xml:lang="fr">Anticlinal de Bel Coster [sic]</skos:hiddenLabel>
	<skos:hiddenLabel xml:lang="it">Anticlinale di Bel Coster [sic]</skos:hiddenLabel>
	<skos:changeNote xml:lang="en">MORA 2026: named after "Le Bel Coster" (i.e. alpages du Grand et du Petit Bel Coster), hence "du" instead of "de".</skos:changeNote>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Anticline"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/BellecombeAnticline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
