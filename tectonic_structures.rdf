	<skos:definition xml:lang="en">The Chapelle-sur-Moudon Anticline is a fold of the Plateau Molasse, situated 2 km to the northwest of Moudon.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
