<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/HohgantRawilFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="fr">Faille synsédimentaire ... Au NW se développent les faciès gréseux de la Fm. du Niederhorhn, tandis qu'au SE se déposent les Fm. du Wildstrubel et du Klimsenhorn.</skos:definition>
	<skos:example xml:lang="de">Hohgant-Rawil-Bruchzone (Menkveld-Gfeller 1994)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Hohgant-Rawil Fault Zone</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Hohgant-Rawil-Bruchzone</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Zone de failles du Hohgant-Rawil</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Zona di faglie Hohgant-Rawil</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ZoneCataclastic"/>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/PanixerpassFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Panixerpass (GL) = Pass dil Veptga (GR): coord. 2726995/1190750</rdfs:isDefinedBy>
	<skos:definition xml:lang="en">Tectonic contact zone situated below the Glarus Thrust and separating the Tschep Nappe in the NE from the Prau-Lurign Slice and the Piz d’Artgas Nappe in the SW.</skos:definition>
	<skos:example xml:lang="en">Panixer Pass Transverse Zone = PPTZ (von Däniken &amp; Frehner 2017)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Panixerpass Fault Zone</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Panixerpass-Bruchzone</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Zone de failles du Panixerpass</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Zona di faglie del Panixerpass</skos:prefLabel>
	<skos:altLabel xml:lang="fr">Faille transverse du Panixerpass</skos:altLabel>
	<skos:altLabel xml:lang="en">Panixerpass Transverse Zone</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ZoneCataclastic"/>
</rdf:Description>

