</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/BoisDeBanThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Bois de Ban Thrust is the frontal NW-vergent thrust delimiting the La Chaumusse Block and hence materialising the Jura Main Thrust.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Bois de Ban Thrust</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Bois-de-Ban-Überschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Chevauchement du Bois de Ban</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sovrascorrimento del Bois de Ban</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/JuraMainThrust"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/HauteJouxThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Haute Joux Thrust is the frontal NW-vergent thrust delimiting the Haute Joux and Remoray Blocks and hence materialising the Jura Main Thrust between the Morez and Mouthe Faults.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Haute Joux Thrust</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Haute-Joux-Überschiebung</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/JuraMainThrust"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/LaveronThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Laveron Thrust is the frontal thrust delimiting the Laveron Block and hence materialising the Jura Main Thrust between the Mouthe and Vallorbe-Pontarlier Faults.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Laveron Thrust</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Laveron-Überschiebung</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/JuraMainThrust"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/MaicheThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Maîche Thrust is the frontal NW-vergent thrust delimiting the Doubs Block and hence materialising the Jura Main Thrust.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Maîche Thrust</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Maîche-Überschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Chevauchement de Maîche</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sovrascorrimento di Maîche</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/JuraMainThrust"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/AjoieThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
