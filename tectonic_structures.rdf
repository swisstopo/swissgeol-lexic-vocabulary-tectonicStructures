<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/AdlerhofAnticline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy xml:lang="en">Gouffon Y. (2024): Tectonic Map of Switzerland 1:50'0000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:isDefinedBy>Adlerhof (BL): coord. 2619130/1261360</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Adlerhof Anticline is a narrow anticline in the Pratteln–Liestal area of the South German Platform (Meyer 2001).</skos:definition>
	<skos:scopeNote xml:lang="en">Jura</skos:scopeNote>
	<skos:example xml:lang="en">Adlerhof Anticline (Meyer 2001, Gouffon et al. 2024)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Adlerhof Anticline</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Adlerhof-Antiklinale</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Anticlinal d'Adlerhof</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Anticlinale di Adlerhof</skos:prefLabel>
	<skos:altLabel xml:lang="de">Adlerhofgewölbe</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Anticline"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/ArbostoraAnticline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Arbostora Anticline is a WSW–ENE trending fold occupying the southern part of the Varesotto Imbricates. It is separated to the north, by the Marzio Fault, from a complex syncline of imbricated Mesozoic sediments.</skos:definition>
	<skos:scopeNote xml:lang="en">Southalpine</skos:scopeNote>
	<skos:example xml:lang="en">Arbostora Anticline (Gouffon et al. 2024)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Arbostora Anticline</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Arbostora-Antiklinale</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Anticlinal d'Arbostora</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Anticlinale di Arbostora</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Anticline"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/LaegernAnticline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Lägern Anticline is the easternmost fold of the Internal Folded Jura cropping out north-west of Zürich.</skos:definition>
	<skos:scopeNote xml:lang="en">Jura</skos:scopeNote>
	<skos:example xml:lang="en">Lägern Anticline (Gouffon et al. 2024)</skos:example>
	<skos:example xml:lang="de">Lägernkette (Heim 1919)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Lägern Anticline</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Lägern-Antiklinale</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Anticlinal de la Lägern</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Anticlinale della Lägern</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Anticline"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/FerretteAnticline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy xml:lang="en">Gouffon Y. (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:isDefinedBy>Ferrette (France 68-Haut-Rhin): coord. 2590690/1260435</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Ferrette Anticline represents the frontal fold (slightly overprinted monoclinal flexure) of the External Folded Jura in the Ferrette region. It has an arcuate and segmented course.</skos:definition>
	<skos:scopeNote xml:lang="en">Jura (Ferrette)</skos:scopeNote>
	<skos:example xml:lang="en">Ferrette Anticline = Bürgerwald Anticline (Gouffon et al. 2024)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Ferrette Anticline</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Ferrette-Antiklinale</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Anticlinal de Ferrette</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Anticlinale di Ferrette</skos:prefLabel>
	<skos:altLabel xml:lang="en">Bürgerwald Anticline</skos:altLabel>
	<skos:altLabel xml:lang="de">Bürgerwald-Antiklinale</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Anticline"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/LandskronAnticline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Landskron Anticline represents the frontal fold (slightly overprinted monoclinal flexure) of the External Folded Jura south-west of Basel.</skos:definition>
	<skos:scopeNote xml:lang="en">Jura (Ferrette)</skos:scopeNote>
	<skos:example xml:lang="en">Landskron Anticline (Gouffon et al. 2024)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Landskron Anticline</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Landskron-Antiklinale</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Anticlinal du Landskron</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Anticlinale del Landskron</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Anticline"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/SpruesselAnticline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Sprüssel Anticline of the Olten region (Hauenstein Basis Tunnnel) belongs to the External Folded Jura.</skos:definition>
	<skos:scopeNote xml:lang="en">Jura</skos:scopeNote>
	<skos:example xml:lang="en">Sprüssel Anticline (Gouffon et al. 2024)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
