	<skos:definition xml:lang="en">The Allinges west Fault (between Mésinges and Perrignier, SW of Allinges) is a SSW-NNE strike-slip fault at the front of the Voirons Nappe.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Allinges west Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Allinges-West-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Accident d'Allinges ouest</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia di Allinges ovest</skos:prefLabel>
	<skos:altLabel xml:lang="en">Allinges western Fault</skos:altLabel>
	<skos:altLabel xml:lang="fr">Faille de Mésinges</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlipSinistral"/>
</rdf:Description>

