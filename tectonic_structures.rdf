	<skos:prefLabel xml:lang="de">La-Rippe-Überschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Chevauchement de la Rippe</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sovrascorrimento della Rippe</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Thrust"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/ThrustBackward">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="fr">… chevauchement dirigé en sens inverse du mouvement tectonique principal.</skos:definition>
