<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/MontVullySyncline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Mont Vully Syncline is a NE–SW trending low amplitude fold of the Foreland Plateau, exposed due to glacial erosion between Lac de Neuchâtel and Lac de Morat.</skos:definition>
	<skos:scopeNote xml:lang="en">Foreland Plateau</skos:scopeNote>
	<skos:example xml:lang="en">Mont Vully Syncline (Gouffon et al. 2024)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Mont Vully Syncline</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Mont-Vully-Synklinale</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Synclinal du Mont Vully</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sinclinale del Mont Vully</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Syncline"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/ChamonixSyncline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The «Chamonix Syncline» is a thin band of Mesozoic sediments separating the Aiguilles Rouges Massif to the north-west and the Mont Blanc Massif to the south-east. Most of these sediments can be considered as belonging to the cover of the Mont Blanc Massif, although this zone probably hides important tectonic contacts, including a probable SW extension of the Rhône-Simplon Fault.</skos:definition>
	<skos:scopeNote xml:lang="en">Helvetic</skos:scopeNote>
	<skos:example xml:lang="en">synclinal complexe de Chamonix-Martigny (Collet et al. 1952), Chamonix-Mulde (Trümpy 1974), couloir de Chamonix (Gourlay 1984), zone de Chamonix (Pairis et al. 1992), Chamonix syncline (Leloup et al. 2005), Chamonix Syncline (Gouffon et al. 2024)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Chamonix Syncline</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Chamonix-Synklinale</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Synclinal de Chamonix</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sinclinale di Chamonix</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Syncline"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/MolareSyncline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Molare Syncline is a fold of the Lucomagno Nappe, with Mesozoic sediments (in particular «Bündnerschiefer») pinched in its core.</skos:definition>
	<skos:scopeNote xml:lang="en">Lepontic</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Molare Syncline</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Molare-Synklinale</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Syclinal du Molare</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Syclinal del Molare</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Syncline"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/StNiklausSyncline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The St. Niklaus Syncline is a fold between the Lower Stalden Zone (Zone Houillère) and the Upper Stalden Zone, resp. the Siviez-Mischabel Nappe, with Mesozoic sediments (in particular «Bündnerschiefer») pinched in its core.</skos:definition>
	<skos:example xml:lang="en">synclinal de S. Niklaus (Bearth 1963), Mulde von St. Niklaus (Bearth 1973, Bearth 1980), St.-Niklaus-Synklinalzone (Sartori et al. 2017)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">St. Niklaus Syncline</skos:prefLabel>
	<skos:prefLabel xml:lang="de">St-Niklaus-Synklinale</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Synclinal de St-Niklaus</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sinclinale di St-Niklaus</skos:prefLabel>
	<skos:altLabel xml:lang="de">St-Niklaus-Mulde</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Syncline"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/MontsetSyncline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Montstet Syncline consists of a narrow recumbent fold of the «Série Rousse» of the Tsaté Nappe within the Mont Fort Nappe (Sartori &amp; Epard 2011). It stretches over more than 20 km though the Val d'Hérémence and the Val d'Hérens.</skos:definition>
	<skos:definition xml:lang="fr">Profond synclinal dont le coeur est constitué par la Série Rousse de la nappe du Tsaté, replissée au sein de la nappe du Mont Fort. Cette structure correspond au «synclinal des Chèques» sensu Wegmann 1923 (non: Vallet 1950, Calame 1954 et Schaer 1959).</skos:definition>
	<skos:scopeNote xml:lang="en">Penninic</skos:scopeNote>
	<skos:example xml:lang="en">synclinal du Montset (Sartori &amp; Epard 2011) synclinal des Chèques (Wegmann 1923)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Montset Syncline</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Montset-Synklinale</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Synclinal du Montset</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sinclinale del Montset</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Syncline"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/LandwasserSyncline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The SW–NE striking Landwasser Syncline comprises the Triassic cover of the Silvretta Nappe at its western edge. It formed during top-NW thrusting in the Cretaceous, and then was overprinted by normal faulting still in the latest Cretaceous. This was followed by top-N thrusting of the entire Silvretta Nappe over the Penninic units during Cenozoic times.</skos:definition>
	<skos:scopeNote xml:lang="en">Graubünden</skos:scopeNote>
	<skos:example xml:lang="en">Ducan- und Landwassermulde (Kräyenbühl 1984), Landwasser- and Ducan trough (Hellermann Furrer 1992), Landwasser and Ducan synclines (Gouffon et al. 2024)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Landwasser Syncline</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Landwasser-Synklinale</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Synclinal de la Landwasser</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sinclinale della Landwasser</skos:prefLabel>
	<skos:altLabel xml:lang="de">Landwasser-Mulde</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Syncline"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/DucanSyncline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The SW–NE striking Ducan Syncline comprises the Triassic cover of the Silvretta Nappe at its western edge. It formed during top-NW thrusting in the Cretaceous, and then was overprinted by normal faulting still in the latest Cretaceous. This was followed by top-N thrusting of the entire Silvretta Nappe over the Penninic units during Cenozoic times.</skos:definition>
	<skos:scopeNote xml:lang="en">Graubünden</skos:scopeNote>
	<skos:example xml:lang="en">Ducan- und Landwassermulde (Kräyenbühl 1984), Ducan-Mulde (Giger 1986), Mesozoico di Ducan (Sciesa 1991), Landwasser- and Ducan trough (Hellermann Furrer 1992), Ducanmulde (Gruber et al. 2010), Ducan-Trias (Furrer et al. 2015), Ducan-Decke, Landwasser and Ducan synclines (Gouffon et al. 2024)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Ducan Syncline</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Ducan-Synklinale</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Synclinal du Ducan</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sinclinale del Ducan</skos:prefLabel>
	<skos:altLabel xml:lang="de">Ducan-Mulde</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Syncline"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

