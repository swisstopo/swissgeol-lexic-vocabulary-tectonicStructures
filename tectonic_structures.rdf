<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/Anticline">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">In an anticline, the oldest strata are found in the core of the fold.</skos:definition>
	<skos:definition xml:lang="fr">Un pli anticlinal présente les couches les plus anciennes au cœur du pli.</skos:definition>
