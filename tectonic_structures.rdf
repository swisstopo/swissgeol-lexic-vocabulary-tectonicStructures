	<skos:definition xml:lang="en">The Bellecombe Anticline is a fold of the southern Jura Mountains, situated in the southern part of the Prémanon Block and extending between the Valserine region to the south and the Col de la Givrine to the north.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
