	<skos:prefLabel xml:lang="de">Überschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">chevauchement</skos:prefLabel>
	<skos:prefLabel xml:lang="it">sovrascorrimento</skos:prefLabel>
	<skos:altLabel xml:lang="en">thrust fault</skos:altLabel>
	<skos:altLabel xml:lang="fr">faille chevauchante</skos:altLabel>
	<skos:altLabel xml:lang="en">overthrust</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultReverse"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ValTrompiaThrust"/>
