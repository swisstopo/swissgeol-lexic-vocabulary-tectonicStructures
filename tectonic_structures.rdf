	<skos:example xml:lang="en">Freiburg-Bonndorf-Bodensee Fault Zone (Schreiner 1992, Geyer et al. 2003, Egli et al. 2017, Diehl et al. 2023, Gouffon et al. 2024), Bonndorfer Grabensystem (Giersch 2004)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Freiburg-Bonndorf-Bodensee Fault Zone</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Freiburg-Bonndorf-Bodensee-Störungszone</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille de Freiburg-Bonndorf-Bodensee</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia di Freiburg-Bonndorf-Bodensee</skos:prefLabel>
	<skos:altLabel xml:lang="en">Bonndorf Graben</skos:altLabel>
	<skos:altLabel xml:lang="de">Bonndorf-Graben</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultNormal"/>
	<skos:closeMatch rdf:resource="https://voc.europe-geology.eu/hike/faults/9266"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/RandenFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Neogene Randen Fault, with a maximum vertical offset of about 250 m, forms - together with the Schiener Berg Fault - the southwestern limit of the central part of the Hegau-Bodensee Graben.</skos:definition>
	<skos:scopeNote xml:lang="en">Süddeutschland</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="de">Randen-Störungszone</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Randen Fault Zone</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Zone de failles du Randen</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Zona di faglie del Randen</skos:prefLabel>
	<skos:altLabel xml:lang="en">Randen Fault</skos:altLabel>
	<skos:altLabel xml:lang="de">Randen-Störung</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultNormal"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/SchienerBergFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Schiener Berg Fault forms - together with the Randen Fault - the southwestern limit of the central part of the Hegau-Bodensee Graben.</skos:definition>
	<skos:scopeNote xml:lang="en">Bodensee</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Schiener Berg Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Schiener-Berg-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille du Schiener Berg</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia del Schiener Berg</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultNormal"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/BachliGiesenenFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Bachli-Giesenen Fault is a synsedimentary fault, now situated at the transition between the Wildhorn Nappe Complex to the west and the Axen and Drusberg Nappes to the east. This fault led to the development of a very thick marl sequence (earliest Cretaceous Palfris Formation) in its eastern compartment, that acted as décollement layer during Alpine nappe stacking.</skos:definition>
	<skos:scopeNote xml:lang="en">Helvetic</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Bachli-Giesenen Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Bachli-Giesenen-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille de Bachli-Giesenen</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia di Bachli-Giesenen</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultNormal"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/MortiroloFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Mortirolo Normal Fault is a Late Cretaceous transtensional top-E directed extensional fault that became folded around the Pass d’Ur Antiform during Cenozoic folding. East of Lago di Poschiavo, the Mortirolo Normal Fault, defining the top of the Masuccio Nappe, abuts the basal thrust of the Campo Nappe Complex that overlies the Lower Austroalpine Bernina Nappe. In ist southern part, in the Adda Valley it separates the Masuccio Nappe (footwall) from the Tonale Nappe (hangingwall).</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Mortirolo Normal Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille normale de Mortirolo</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Mortirolo-Abschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia diretta di Mortirolo</skos:prefLabel>
	<skos:altLabel xml:lang="en">Mortirolo Fault</skos:altLabel>
	<skos:altLabel xml:lang="de">Mortirolo-Störung</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/Detachment"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/PejoFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Pejo Fault is a Late Cretaceous SE-dipping normal fault that accommodates top-E extension combined with a sinistral strike-slip component in the present-day map view. The amount of displacement across the Pejo Normal Fault seems to be substantial since this fault juxtaposes the Tonale Nappe that lacks Alpine metamorphic overprint with the southernmost Campo Nappe Complex that was at least locally metamorphosed under upper greenschist-facies conditions during the Alpine cycle.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Pejo Normal Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Pejo-Abschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille normale de Pejo</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia diretta di Pejo</skos:prefLabel>
	<skos:altLabel xml:lang="en">Pejo Fault</skos:altLabel>
	<skos:altLabel xml:lang="de">Pejo-Störung</skos:altLabel>
	<skos:altLabel xml:lang="de">Peio-Linie</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultNormal"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/LuganoMonteGronaValGrandeFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Lugano-Monte Grona-Val Grande Fault System is a major Mesozoic normal fault of the South Alpine domain. It is subdivided into three segments: the N–S trending Lugano Fault (between Mendrisio and Lugano), the W–E oriented Monte Grona Fault (between Lugano and Lago di Como) and the SW–NE oriented Val Grande Fault (between Lago di Como and M. Legnone).</skos:definition>
	<skos:scopeNote xml:lang="en">Southalpine</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Lugano-Monte Grona-Val Grande Fault System</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Système de failles Lugano-Monte Grona-Val Grande</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sistema di faglie Lugano-Monte Grona-Val Grande</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Lugano-Val-Grande-Störungssystem</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultNormal"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/LuganoFault"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/MonteGronaFault"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ValGrandeFault"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/Detachment">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">A detachment is a low-angle normal fault with accomodating a large displacement.</skos:definition>
	<skos:definition xml:lang="fr">Un détachement est une faille normale de grande extension et faible pendage.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">detachment</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Abschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">détachement</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultNormal"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/MortiroloFault"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/MezzaunFault"/>
	<skos:narrower rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/PogalloFault"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/SimplonFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Simplonpass = Passo del Sempione (VS), coord. 2644220/1119735</rdfs:isDefinedBy>
	<skos:definition xml:lang="en">The Simplon Fault is a normal fault responsible for much of the exhumation of the western Lepontic nappes (Mancktelow 1990, Steck 2008 and ref.therein). It extends over the Simplonpass between Visp in the Rhône Valley and Domodossola in the Valle d’Ossola.According to Keller et al. (2005), the southeastern termination of this normal fault near Domodossola represents a rapid transition to a dextral strike-slip segment, the same as for the Centovalli Fault. A connection between the two faults is considered by some authors but rejected by others (see § 10.2). The western part of the Simplon Normal Fault splits in two branch and links with the seismically still active Rhône Fault associated with dextral strike-slip motion. The Simplon Fault was active during the 19  –3 Ma time span (Grasemann &amp; Mancktelow 1993, Campani et al. 2010, Bergemann et al. 2020) and, together with the older Simplon Ductile Shear Zone, kinematically acted as a tensile bridge between the dextral movements along the Rhône Fault and the Tonale Fault, respectively (Schmid &amp; Kissling 2000).</skos:definition>
	<skos:definition xml:lang="fr">Important accident tectonique situé de part et d'autre du col du Simplon.</skos:definition>
	<skos:scopeNote xml:lang="en">Valais</skos:scopeNote>
	<skos:example xml:lang="en">Simplon line (Pfeifer et al. 1991, Carrupt 2003)</skos:example>
	<skos:example xml:lang="fr">accident du Simplon (Gouffon 1993)</skos:example>
	<skos:example xml:lang="it">linea del Sempione = faglia del Sempione (Dal Piaz et al. 1992a)</skos:example>
	<skos:example xml:lang="fr">Ligne du Simplon = Simplon-Störung (Ackermann et al. 1991)</skos:example>
	<skos:example xml:lang="fr">ligne du Simplon + accident du Simplon (Jeanbourquin &amp; Burri 1989)</skos:example>
	<skos:example xml:lang="de">Simplon-Störung (Bearth 1956 fig.1, Bearth 1973)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Simplon Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Simplon-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille du Simplon</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia del Simplon</skos:prefLabel>
	<skos:altLabel xml:lang="en">Simplon Normal Fault, Simplon Line</skos:altLabel>
	<skos:altLabel xml:lang="it">Faglia del Sempione</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultNormal"/>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/RhoneSimplonFault"/>
	<adms:status xml:lang="en">active</adms:status>
	<dct:source>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</dct:source>
	<dct:bibliographicCitation>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</dct:bibliographicCitation>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/OspizioSottileFault">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The SW- NE trending Ospizio-Sottile Fault is a sinistral strike-slip fault of Miocene age (Bistacchi et al. 2000).</skos:definition>
	<skos:example xml:lang="en">Ospizio-Sottile fault (Babist et al. 2006)</skos:example>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Ospizio-Sottile Fault</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Ospizio-Sottile-Störung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Faille Ospizio-Sottile</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Faglia Ospizio-Sottile</skos:prefLabel>
	<skos:altLabel xml:lang="de">Ospizio-Sottile-Linie</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/FaultStrikeSlipSinistral"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

