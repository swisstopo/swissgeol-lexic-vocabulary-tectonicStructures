<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/GlarusThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">… basal thrust of the Glarus Nappe Complex (and hence of the Upper Helvetic Subdomain), with a displacement of 30-35 km (Pfiffner 2011).</skos:definition>
	<skos:definition xml:lang="de">Hauptüberschiebung der helvetischen Decken in der Ostschweiz. Diese Überschiebung entstand mehrphasig und schneidet messerscharf durch älteren Strukturen. Teile der Front der überschiebenden Decke wurden überfahren und liegen nun als Reste unterhalb der Hauptüberschiebung.</skos:definition>
	<skos:scopeNote xml:lang="en">Helvetic</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Glarus Main Thrust</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Glarner Hauptüberschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Chevauchement principal de Glaris</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sovrascorrimento principale di Glarona</skos:prefLabel>
	<skos:altLabel xml:lang="en">Glarus Thrust</skos:altLabel>
	<skos:altLabel xml:lang="de">Glarner Überschiebung</skos:altLabel>
	<skos:altLabel xml:lang="fr">Chevauchement de Glaris</skos:altLabel>
	<skos:altLabel xml:lang="it">Sovrascorrimento di Glarona</skos:altLabel>
	<skos:altLabel xml:lang="en">basal thrust of the Glarus Nappe Complex</skos:altLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ThrustForward"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/AxenThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:isDefinedBy>Gouffon Yves (Editor) (2024): Tectonic Map of Switzerland 1:500000, Explanatory notes. Federal Office of Topography swisstopo, Wabern</rdfs:isDefinedBy>
	<rdfs:comment>https://data.geo.admin.ch/ch.swisstopo.geologie-tektonische_karte/pdf/Erl-TK500_2024.pdf</rdfs:comment>
	<skos:definition xml:lang="en">The Axen Thrust is a major out-of-sequence thrust of the second deformation phase of the Helvetic, which cuts the entire structural framework formed during the first deformation phase. It separates the Lower Helvetic (below) from the Upper Helvetic (above), with a displacement of 20-25 km (Pfiffner 2011).</skos:definition>
	<skos:scopeNote xml:lang="en">Helvetic</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
	<skos:prefLabel xml:lang="en">Axen Thrust</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Axen-Überschiebung</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Chevauchement de l'Axen</skos:prefLabel>
	<skos:prefLabel xml:lang="it">Sovrascorrimento del Axen</skos:prefLabel>
	<skos:broader rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/ThrustForward"/>
	<adms:status xml:lang="en">active</adms:status>
</rdf:Description>

