<rdf:Description rdf:about="https://lexic.swissgeol.ch/TectonicStructures/MijouxThrust">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:definition xml:lang="en">The Mijoux Thrust is the frontal thrust bringing the La Dôle Block ontop of the Prémanon Block.</skos:definition>
	<skos:scopeNote xml:lang="en">swissJura3D</skos:scopeNote>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
