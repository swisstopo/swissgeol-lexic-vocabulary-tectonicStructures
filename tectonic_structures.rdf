	<skos:definition xml:lang="en">The Bret-Novel Fault is a NW-SE oriented dextral strike-slip fault of the Chablais Prealps in the Grammont region. It consists of two disjoint segments.</skos:definition>
	<skos:inScheme rdf:resource="https://lexic.swissgeol.ch/TectonicStructures/TectonicStructures"/>
